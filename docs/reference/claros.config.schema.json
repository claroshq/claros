{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/claroshq/claros/blob/main/docs/reference/claros.config.schema.json",
  "title": "Claros product configuration (claros apply, PUT /v1/config)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "prune": {
      "type": "boolean"
    },
    "settings": {
      "type": "object",
      "properties": {
        "brand": {
          "type": "object",
          "additionalProperties": {}
        },
        "throttle": {
          "type": "object",
          "additionalProperties": {}
        },
        "postal_address": {
          "type": "string",
          "maxLength": 500
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          },
          "propertyNames": {
            "pattern": "^[a-z0-9_]{1,64}$"
          }
        },
        "link_tracking": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "maxItems": 50
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "propertyNames": {
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  },
                  "default": {}
                },
                "click_id": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "domains"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "locale": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "brain": {
          "type": "object",
          "properties": {
            "guidelines": {
              "type": "string",
              "maxLength": 20000
            },
            "text_rules": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "object",
                    "properties": {
                      "find": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "replace": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "find",
                      "replace"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "forbid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "forbid"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "maxItems": 100
            },
            "assess": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "activation_events": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 50
            },
            "activation_window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "natural_frequency_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "at_risk_missed_intervals": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52
            },
            "dormant_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            "churned_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            "engagement_depth_window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "power_user_percentile": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          },
          "additionalProperties": false
        },
        "llm_daily_token_budget": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "approvals": {
          "type": "object",
          "properties": {
            "daily_digest": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "data_sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2000
              },
              "secret": {
                "type": "string",
                "minLength": 16,
                "maxLength": 500
              },
              "secret_ref": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
              },
              "secret_env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 100,
                "maximum": 30000
              },
              "signature": {
                "const": "standard-webhooks"
              },
              "modes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "maxItems": 20
              },
              "response_shape": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^[a-z0-9_]{1,64}$"
          }
        },
        "date_traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 50
        },
        "activation_events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 50
        },
        "analytics": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "sink": {
                  "type": "string",
                  "enum": [
                    "statsraven",
                    "webhook"
                  ]
                },
                "endpoint": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2000
                },
                "site_key": {
                  "type": "string",
                  "maxLength": 200
                },
                "secret": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 500
                }
              },
              "required": [
                "sink",
                "endpoint"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "marketing",
              "lifecycle",
              "transactional"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "default_subscribed": {
            "type": "boolean"
          },
          "mirror_only": {
            "type": "boolean"
          }
        },
        "required": [
          "slug",
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "body_html": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "body_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200000
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slug",
          "name",
          "subject",
          "body_html"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "transports": {
      "type": "object",
      "properties": {
        "routing": {
          "type": "object",
          "properties": {
            "transactional": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "default": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "routing"
      ],
      "additionalProperties": false
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "draft"
            ]
          },
          "trigger": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "event",
                  "lifecycle_transition",
                  "segment",
                  "manual",
                  "date_property",
                  "date_schedule"
                ]
              },
              "event": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                ]
              },
              "where": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/audienceCondition"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/audienceCondition"
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                ]
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "tenure_bucket": {
                "type": "string",
                "enum": [
                  "new",
                  "growing",
                  "established",
                  "loyal"
                ]
              },
              "recency_bucket": {
                "type": "string",
                "enum": [
                  "active",
                  "cooling",
                  "idle",
                  "dormant"
                ]
              },
              "lifecycle_states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "signed_up",
                    "activated",
                    "engaged",
                    "at_risk",
                    "dormant",
                    "churned",
                    "resurrected"
                  ]
                },
                "minItems": 1,
                "maxItems": 7
              },
              "engagement_depths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "power",
                    "regular",
                    "casual",
                    "minimal"
                  ]
                },
                "minItems": 1,
                "maxItems": 4
              },
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "offset": {
                "type": "string"
              },
              "anchor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "offsets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "repeat": {
                "type": "string"
              },
              "max_sends": {
                "type": "integer"
              },
              "send_at_local": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "action_type": {
                  "type": "string",
                  "minLength": 1
                },
                "delay": {
                  "type": "string",
                  "pattern": "^\\d+(m|h|d)$"
                },
                "window_policy": {
                  "type": "string",
                  "enum": [
                    "immediate",
                    "respect_window"
                  ]
                },
                "template_ref": {
                  "type": "string"
                },
                "kb_ref": {
                  "type": "string"
                },
                "brain_instruction": {
                  "type": "string"
                },
                "condition": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/stepCondition"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/stepCondition"
                      },
                      "minItems": 1,
                      "maxItems": 20
                    }
                  ]
                },
                "exit_condition": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/stepCondition"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/stepCondition"
                      },
                      "minItems": 1,
                      "maxItems": 20
                    }
                  ]
                },
                "expires_after": {
                  "type": "string",
                  "pattern": "^\\d{1,6}(m|h|d)$"
                },
                "context": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]{1,64}$"
                      },
                      "mode": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "source"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 5
                },
                "on_empty": {
                  "type": "string",
                  "enum": [
                    "skip",
                    "send"
                  ]
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "defer",
                    "skip",
                    "fail"
                  ]
                },
                "kb_select": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "exclude_used": {
                      "type": "boolean"
                    },
                    "pick": {
                      "type": "string",
                      "enum": [
                        "oldest_unused",
                        "best_match"
                      ]
                    },
                    "tags_any_from_trait": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "category"
                  ],
                  "additionalProperties": false
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "send",
                    "choose"
                  ]
                },
                "candidates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action_type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "when": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/audienceCondition"
                          },
                          {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/audienceCondition"
                            },
                            "minItems": 1,
                            "maxItems": 20
                          }
                        ]
                      },
                      "kb_select": {
                        "type": "object",
                        "properties": {
                          "category": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "exclude_used": {
                            "type": "boolean"
                          },
                          "pick": {
                            "type": "string",
                            "enum": [
                              "oldest_unused",
                              "best_match"
                            ]
                          },
                          "tags_any_from_trait": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        },
                        "required": [
                          "category"
                        ],
                        "additionalProperties": false
                      },
                      "context": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "pattern": "^[a-z0-9_]{1,64}$"
                            },
                            "mode": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            "limit": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 100
                            }
                          },
                          "required": [
                            "source"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 5
                      },
                      "cooldown": {
                        "type": "string",
                        "pattern": "^\\d{1,6}(m|h|d)$"
                      },
                      "template_ref": {
                        "type": "string"
                      },
                      "brain_instruction": {
                        "type": "string"
                      },
                      "eyebrow": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "allowed_links": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z0-9_]{1,64}$"
                        },
                        "minItems": 1,
                        "maxItems": 20
                      }
                    },
                    "required": [
                      "action_type"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 20
                },
                "allow_none": {
                  "type": "boolean"
                },
                "from_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "reply_to": {
                  "type": "string",
                  "maxLength": 320
                },
                "eyebrow": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "preheader": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "allowed_links": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]{1,64}$"
                  },
                  "minItems": 1,
                  "maxItems": 20
                },
                "single_cta": {
                  "type": "boolean"
                }
              },
              "required": [
                "order",
                "action_type",
                "delay"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          },
          "exit_conditions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/planExitCondition"
            },
            "maxItems": 20
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "content_mode": {
            "type": "string",
            "enum": [
              "ai_drafted",
              "fixed_content"
            ]
          },
          "approval_mode": {
            "type": "string",
            "enum": [
              "require",
              "auto"
            ]
          },
          "flow_class": {
            "type": "string",
            "enum": [
              "critical",
              "nurture",
              "scheduled"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "reentry": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string",
                "enum": [
                  "once",
                  "cooldown",
                  "every_time"
                ]
              },
              "cooldown_days": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3650
              }
            },
            "required": [
              "policy"
            ],
            "additionalProperties": false
          },
          "topic": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slug",
          "name",
          "trigger"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "webhooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "message.sent",
                "message.delivered",
                "message.opened",
                "message.clicked",
                "message.bounced",
                "message.complained",
                "message.failed",
                "message.pending_approval",
                "contact.subscribed",
                "contact.unsubscribed",
                "contact.resubscribed",
                "contact.suppressed",
                "flow.enrolled",
                "flow.exited"
              ]
            },
            "minItems": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "secret": {
            "type": "string",
            "minLength": 16,
            "maxLength": 200
          },
          "batch_interval_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          }
        },
        "required": [
          "slug",
          "url",
          "events"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    }
  },
  "additionalProperties": false,
  "$defs": {
    "audienceCondition": {
      "anyOf": [
        {
