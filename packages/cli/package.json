{
  "name": "@claroshq/claros",
  "version": "0.8.9",
  "description": "Deploy and operate Claros on Cloudflare Workers + D1",
  "keywords": [
    "claros",
    "lifecycle-email",
    "email",
    "cloudflare",
    "cloudflare-workers",
    "d1",
    "self-hosted",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claroshq/claros.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/claroshq/claros/blob/main/docs/install/cloudflare.md",
  "bugs": {
    "url": "https://github.com/claroshq/claros/issues"
  },
  "bin": {
    "claros": "bin/claros.mjs"
  },
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle-assets": "node scripts/bundle-assets.mjs",
    "prepack": "npm run build --prefix ../.. && node scripts/bundle-assets.mjs"
  },
  "dependencies": {
    "wrangler": "^4.168.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
