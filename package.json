{
  "name": "claros",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @claros/server",
    "dev:dashboard": "npm run dev -w @claros/dashboard",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @claros/core -w @claros/adapters -w @claros/brain-oss -w @claros/db -w @claros/store -w @claros/api -w @claros/worker -w @claros/scheduler && npm run typecheck --workspaces --if-present",
    "test": "bash scripts/test.sh",
    "check": "bash scripts/check.sh",
    "db:generate": "drizzle-kit generate --config drizzle/drizzle.config.ts",
    "db:migrate": "bash scripts/migrate.sh",
    "test:upgrade": "bash scripts/test-upgrade.sh",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle/drizzle.sqlite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.22.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "workspaces": [
    "packages/core",
    "packages/adapters",
    "packages/brain-oss",
    "drizzle",
    "packages/store",
    "packages/api",
    "packages/worker",
    "packages/scheduler",
    "apps/server",
    "apps/dashboard",
    "apps/worker"
  ],
  "packageManager": "npm@10.9.11"
}
